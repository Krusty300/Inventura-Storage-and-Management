# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app will refuse to start with an empty or placeholder SECRET_KEY.
SECRET_KEY=

# DATABASE_URL — leave as the default sqlite for a single-file local database,
# or use a postgres URL (e.g. postgresql+psycopg://user:pass@host:5432/db) in prod.
DATABASE_URL=sqlite:///./inventory.db

# ─── SECRET_KEY rotation ─────────────────────────────────────────────────────
# When rotating SECRET_KEY, put the PREVIOUS key(s) here (comma-separated).
# Tokens signed with the old key remain valid for KEY_ROTATION_GRACE_HOURS so
# existing sessions do not log users out. New tokens always use SECRET_KEY.
# After the grace period expires, remove the old key from this list.
#   SECRET_KEY=<new>
#   PREVIOUS_SECRET_KEYS=<old>
PREVIOUS_SECRET_KEYS=

# How many hours old-key tokens remain accepted after rotation.
KEY_ROTATION_GRACE_HOURS=72
